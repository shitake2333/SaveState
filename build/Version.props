<Project>

  <!--
    One version for every package (the generator and the runtime must be shipped as a matching pair).
    Change VersionPrefix to release; set VersionSuffix to a prerelease tag (alpha.1, beta.2 …) or leave it empty.
  -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <Version Condition="'$(VersionSuffix)' == ''">$(VersionPrefix)</Version>
    <Version Condition="'$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</Version>
  </PropertyGroup>

</Project>
