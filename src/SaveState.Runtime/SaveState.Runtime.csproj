<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SaveState.Runtime - the save/load runtime: atomic-write file store, in-memory store, JSON policy, migration pipeline, save session.
    Depends on SaveState.Shared; System.Text.Json only needs an explicit reference under the netstandard2.0 target (net10 already ships it).
  -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <RootNamespace>SaveState</RootNamespace>
    <AssemblyName>SaveState.Runtime</AssemblyName>
    <PackageId>SaveState.Runtime</PackageId>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\build\Version.props" />

  <ItemGroup>
    <ProjectReference Include="..\SaveState.Shared\SaveState.Shared.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <!-- netstandard2.0 has no built-in System.Text.Json; the net10.0 target uses the version the framework ships. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
