<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SaveState.Samples.Console</RootNamespace>
    <AssemblyName>SaveState.Samples.Console</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\build\Version.props" />

  <ItemGroup>
    <ProjectReference Include="..\..\src\SaveState.Shared\SaveState.Shared.csproj" />
    <ProjectReference Include="..\..\src\SaveState.Runtime\SaveState.Runtime.csproj" />
    <ProjectReference Include="..\..\src\SaveState.Policy\SaveState.Policy.csproj" />
    <!-- The generator is referenced as an analyzer: writing [SaveFile]/[SavedState] in a host project is enough to generate the implementations. -->
    <ProjectReference Include="..\..\src\SaveState.Generator\SaveState.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
