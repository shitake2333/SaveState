<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SaveState.Tests</RootNamespace>
    <AssemblyName>SaveState.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Emit the generated files to disk so they can be inspected by hand and asserted as golden output. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\build\Version.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- The generator diagnostic tests drive the generator in-process (using the same Roslyn version as the analyzer). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SaveState.Shared\SaveState.Shared.csproj" />
    <ProjectReference Include="..\..\src\SaveState.Runtime\SaveState.Runtime.csproj" />
    <ProjectReference Include="..\..\src\SaveState.Policy\SaveState.Policy.csproj" />
    <!-- OutputItemType=Analyzer: this project's test model classes get their implementations from the generator; the assembly reference is kept as well so that tests can drive the generator directly. -->
    <ProjectReference Include="..\..\src\SaveState.Generator\SaveState.Generator.csproj" OutputItemType="Analyzer" />
  </ItemGroup>

</Project>
